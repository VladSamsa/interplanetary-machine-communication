# 1. Detectar la IP local de tu laptop automáticamente
MY_IP=$(hostname -I | awk '{print $1}')
echo "Configurando Nodo 1 en IP: $MY_IP"

# 2. Crear host_node1.rc en el directorio actual
cat << EOF > host_node1.rc
## begin ionadmin
1 1 ''
s
a contact +0 +3600 1 1 100000
a range +0 +3600 1 1 1
a contact +0 +900 1 2 100000
a contact +0 +900 2 1 50000
a range +0 +900 1 2 3
a contact +1020 +3600 1 2 100000
a contact +1020 +3600 2 1 50000
a range +1020 +3600 1 2 3
m production 1000000
m consumption 1000000
## end ionadmin

## begin bpadmin
1
a scheme ipn 'ipnfw' 'ipnadminep'
a endpoint ipn:1.0 q
a endpoint ipn:1.1 q
a endpoint ipn:1.2 q
a protocol udp 1400 100
a induct udp ${MY_IP}:4556 udpcli
a outduct udp 192.168.1.105:4556 udpclo
s
## end bpadmin

## begin ipnadmin
a plan 1 udp/${MY_IP}:4556
a plan 2 udp/192.168.1.105:4556
## end ipnadmin
EOF